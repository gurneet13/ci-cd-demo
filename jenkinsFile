pipeline {
    agent any

    tools {
        nodejs 'NodeJS26'   // must match exactly what you named it here
    }

    environment {
        AWS_ENDPOINT_URL      = 'http://floci:4566'
        AWS_REGION            = 'us-east-1'
        AWS_ACCESS_KEY_ID     = 'test'
        AWS_SECRET_ACCESS_KEY = 'test'
        S3_BUCKET             = 'my-test-bucket'
        EKS_CLUSTER_NAME      = 'my-cluster'
        PORT                  = '3000'
        KUBECONFIG            = "${WORKSPACE}/k3s-kubeconfig.yaml"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install deps') {
            steps {
                sh 'npm install'
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                node index.js &
                APP_PID=$!

                cleanup() { kill $APP_PID 2>/dev/null || true; }
                trap cleanup EXIT

                for i in $(seq 1 30); do
                    if curl -sf http://localhost:3000/healthz >/dev/null && \
                       curl -sf http://localhost:3000/ready >/dev/null; then
                        echo "App is healthy and ready"
                        exit 0
                    fi
                    sleep 1
                done

                echo "App did not become healthy/ready in time"
                exit 1
                '''
            }
        }

        stage('Create/verify EKS cluster') {
            steps {
                sh '''
                aws --endpoint-url=$AWS_ENDPOINT_URL eks describe-cluster \
                    --name $EKS_CLUSTER_NAME >/dev/null 2>&1 || \
                aws --endpoint-url=$AWS_ENDPOINT_URL eks create-cluster \
                    --name $EKS_CLUSTER_NAME \
                    --role-arn arn:aws:iam::000000000000:role/eks-role \
                    --resources-vpc-config subnetIds=subnet-default-us-east-1-a,subnet-default-us-east-1-b

                until aws --endpoint-url=$AWS_ENDPOINT_URL eks describe-cluster \
                    --name $EKS_CLUSTER_NAME --query "cluster.status" --output text | grep -q ACTIVE; do
                    echo "waiting for cluster to become ACTIVE..."
                    sleep 5
                done
                '''
            }
        }

        stage('Get kubeconfig') {
            steps {
                sh '''
                docker exec floci-eks-$EKS_CLUSTER_NAME cat /etc/rancher/k3s/k3s.yaml > $WORKSPACE/k3s-kubeconfig.yaml
                sed -i 's#server: https://127.0.0.1:6443#server: https://host.docker.internal:6500#' $WORKSPACE/k3s-kubeconfig.yaml

                CLUSTER_NAME=$(KUBECONFIG=$WORKSPACE/k3s-kubeconfig.yaml kubectl config view -o jsonpath='{.clusters[0].name}')

                KUBECONFIG=$WORKSPACE/k3s-kubeconfig.yaml kubectl config set-cluster $CLUSTER_NAME \
                    --insecure-skip-tls-verify=true
                '''
            }
        }

        stage('Build Docker image') {
            steps {
                sh 'docker build -t my-app:latest .'
            }
        }

        stage('Load image into k3s') {
            steps {
                sh '''
                docker save my-app:latest | docker exec -i floci-eks-my-cluster ctr images import -
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f k8s/deployment.yaml'
            }
        }
    }

    post {
        always {
            echo "Pipeline finished for branch: ${env.BRANCH_NAME ?: 'prod'}"
        }
    }
}